        {
          "titel": "Koma",
          "text": [
            "Nähert sich Seyran dem Stern Ilaren, verdampft Eis und bildet eine leuchtende Gashülle um den Kern."
          ]
        },
        {
          "titel": "Aktivität nahe dem Perihel",
          "text": [
            "Bei Annäherung an Ilaren sublimieren oberflächennahe Eise. Eine temporäre Koma aus Gas und Staub entsteht; in großer Entfernung bleibt Seyran überwiegend inaktiv."
          ]
        }
      ]
    },
    "Schweif": {
      "gruppe": "Natur",
      "icon": "☄",
      "intro": "Schweif von Seyran.",
      "abschnitte": [
        {
          "titel": "Schweif",
          "text": [
            "Seyran ist ein langperiodischer eisreicher Kleinkörper aus der äußeren Region des Systems. Seine stark geneigte, langgestreckte Bahn bleibt im Arbeitsmodell außerhalb der Planetenbahnen; bei sonnennahem Durchgang bildet sich eine Koma mit Schweif."
          ]
        },
        {
          "titel": "Zwei vom Stern geformte Schweife",
          "text": [
            "Gas wird durch ultraviolette Strahlung ionisiert und vom Sternwind weggetragen. Größere Staubteilchen folgen stärker der Bahn und bilden einen gekrümmten Staubschweif. Beide richten sich nicht dauerhaft entlang derselben Linie aus."
          ]
        }
      ]
