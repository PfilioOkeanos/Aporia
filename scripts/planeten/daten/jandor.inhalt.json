          "karten": [
            {
              "titel": "Ithel",
              "text": "3.300 km Durchmesser, Umlauf in 4,2 Tage. Ithel ist der größte Eismond Jandors. Lange, bläuliche Risse durchziehen seine Eiskruste – Hinweise auf Spannungen über einem möglichen tiefen Wasserozean."
            },
            {
              "titel": "Orrund",
              "text": "2.200 km Durchmesser, Umlauf in 9,1 Tage. Orrund ist ein felsiger Mond Jandors mit tiefen Bruchzonen in seiner alten, kraterreichen Kruste."
            },
            {
              "titel": "Vasch",
              "text": "60 km Durchmesser, Umlauf in 160 Tage. Vasch ist ein kleiner, länglicher und unregelmäßiger Mond auf weiter, rückläufiger Bahn – vermutlich ein eingefangener Kleinkörper."
            }
          ],
