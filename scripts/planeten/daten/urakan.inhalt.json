        },
        {
          "titel": "Monde",
          "karten": [
            {
              "titel": "Nair",
              "text": "3.500 km Durchmesser, Umlauf in 36,5 Stunden. Nair ist der innerste der vier größeren Monde Urakans – ein vulkanisch aktiver Gesteinsmond mit Lavafeldern und schwefelhaltigen Ablagerungen. Die Resonanz mit Sirel und Valdor heizt sein Inneres durch Gezeitenverformung."
            },
            {
              "titel": "Sirel",
              "text": "3.000 km Durchmesser, Umlauf in 3 Tage. Sirel ist ein eisiger Ozeanmond mit großen Risssystemen. Unter der Eisoberfläche könnte ein salzhaltiger Ozean liegen – ein besonders interessanter Kandidat für mögliche unterirdische Lebensräume."
            },
            {
              "titel": "Valdor",
              "text": "4.800 km Durchmesser, Umlauf in 6,1 Tage. Valdor ist ein großer Eis-Gesteins-Mond mit alten Einschlagbecken und Eisregionen; ein tiefer Salzwasserozean ist möglich."
            },
            {
              "titel": "Erym",
              "text": "2.200 km Durchmesser, Umlauf in 19,5 Tage. Erym ist ein alter, stark verkraterter Außenmond Urakans mit geringer innerer Aktivität – wichtig für die Rekonstruktion der frühen Systemgeschichte."
            }
          ],
          "verweise": [
