      "intro": "Besonderheiten von Urakan.",
      "abschnitte": [
        {
          "titel": "Besonderheiten",
          "liste": [
            "Größter Planet des Terev-Systems",
            "4 Monde: Nair, Sirel, Valdor, Erym"
