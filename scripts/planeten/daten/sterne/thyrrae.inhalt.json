        {
          "titel": "Monde",
          "karten": [
            {
              "titel": "Thyrrae I",
              "text": "7.800 km Durchmesser, Umlauf in 82,3 Tage. Thyrrae I ist ein kleiner, glühend heißer Gesteinsplanet ohne nennenswerte Atmosphäre."
            },
            {
              "titel": "Thyrrae II",
              "text": "13.800 km Durchmesser, Umlauf in 214,7 Tage. Thyrrae II ist eine heiße Treibhauswelt unter einer geschlossenen, hellen Wolkendecke."
            },
            {
              "titel": "Babiew",
              "text": "104.000 km Durchmesser, Umlauf in 520,9 Tage. Babiew ist die Heimatwelt der Aeromorphen: eine Gaswelt mit mächtiger, extrem bewegter Atmosphäre, dauerhaften Sturmsystemen und Winden bis 1.000 km/h."
            },
            {
              "titel": "Raumzeitnarbe",
              "text": "30 km Durchmesser, Umlauf in 521 Tage. Ein kleiner, schwach leuchtender Körper im nachlaufenden Lagrange-Punkt von Babiew. Messungen zeigen Spuren von Datoralium – möglicherweise ein Rest der Raumzeitanomalie, aus der die Aeromorphen hervorgingen."
            },
            {
              "titel": "Thyrrae V",
              "text": "48.000 km Durchmesser, Umlauf in 27,7 Jahre. Thyrrae V ist ein ferner, blassblauer Eisriese."
            },
            {
              "titel": "Windkomet",
              "text": "12 km Durchmesser, Umlauf in 50,4 Jahre. Ein Komet mit gewundenem, mehrfach geteiltem Schweif, der alle 52 Jahre das innere System durchquert. Die Aeromorphen deuten seine Wiederkehr als Zeichen großer Strömungswechsel."
            }
          ],
