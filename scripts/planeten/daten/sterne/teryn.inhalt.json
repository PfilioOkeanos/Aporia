          "liste": [
            "10 eigene Planeten: Dareth, Nura, Iskara, Veldros, Mirven, Othes, Kaltor, Saevor, Ynderal, Nemor"
          ]
        },
        {
          "titel": "Planeten",
          "karten": [
            {
              "titel": "Dareth",
              "text": "9.400 km Durchmesser, Umlauf in 24 Tage. Dareth ist eine stark bestrahlte, weitgehend trockene Gesteinswelt mit alten Einschlagsbecken, mineralischen Hochländern und vulkanisch geprägten Ebenen."
            },
            {
              "titel": "Nura",
              "text": "12.200 km Durchmesser, Umlauf in 82 Tage. Nura ist eine heiße terrestrische Welt mit dichter, überwiegend kohlendioxidreicher Atmosphäre. Oberflächenbedingungen sind extrem und für erdähnliches Leben ungeeignet."
            },
            {
              "titel": "Iskara",
              "text": "13.380 km Durchmesser, Umlauf in 197 Tage. Iskara ist die Heimatwelt der Solitiden: ein geologisch aktiver Silikatplanet mit 48 Prozent Wasserflächen, hydrothermalen Bruchsystemen und einer gewöhnlichen kohlenstoffbasierten Biosphäre. Seltene mineralische Formationen tragen die natürlich entstandenen Solitiden. Die globale Mitteltemperatur von etwa 12 °C ist ein Dossiermodellwert."
            },
            {
              "titel": "Veldros",
              "text": "21.000 km Durchmesser, Umlauf in 464,2 Tage. Veldros ist eine kalte Supererde mit eisreichen Hochländern, mineralischen Tiefenstrukturen und möglichen unterirdischen Flüssigkeitsreservoirs."
            },
            {
              "titel": "Mirven",
              "text": "184 km Durchmesser, Umlauf in 2,5 Jahre. Mirven ist ein größerer kartierter Körper im inneren Bereich des Veylan-Asteroidengürtels."
            },
            {
              "titel": "Othes",
              "text": "134 km Durchmesser, Umlauf in 2,7 Jahre. Othes ist ein mittelgroßer silikatischer Kleinkörper im Veylan-Gürtel. Seine Bahn liegt zwischen Mirven und Kaltor."
            },
            {
              "titel": "Kaltor",
              "text": "236 km Durchmesser, Umlauf in 3 Jahre. Kaltor ist ein größerer eis- und gesteinsreicher Körper im äußeren Bereich des Veylan-Asteroidengürtels."
            },
            {
              "titel": "Saevor",
              "text": "134.000 km Durchmesser, Umlauf in 5,4 Jahre. Saevor ist ein Gasriese von etwa 0,68 Jupitermassen mit ausgeprägten Wolkenbändern, ausgedehnten Sturmsystemen und einem modellierten Ringsystem."
            },
            {
              "titel": "Ynderal",
              "text": "62.400 km Durchmesser, Umlauf in 16,2 Jahre. Ynderal ist ein kalter, eisreicher Riesenplanet mit wasserstoffreicher Atmosphäre und einem Ringsystem."
            },
            {
              "titel": "Nemor",
              "text": "144 km Durchmesser, Umlauf in 133,1 Jahre. Nemor ist ein benannter eisreicher Kleinkörper aus der äußeren Region des Teryn-Systems. Seine Bahnparameter sind Modellwerte für die Sternenkarte."
            }
          ],
