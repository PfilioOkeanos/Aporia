        {
          "titel": "Monde",
          "karten": [
            {
              "titel": "Seyvar I",
              "text": "6.600 km Durchmesser, Umlauf in 63 Tage. Seyvar I ist ein kleiner, sonnennaher Gesteinsplanet ohne nennenswerte Atmosphäre, dessen Tagseite stark aufgeheizt wird."
            },
            {
              "titel": "Nhalyss",
              "text": "11.980 km Durchmesser, Umlauf in 246,4 Tage. Nhalyss ist die Heimatwelt der Bioluminoiden: ein geologisch aktiver Gesteinsplanet mit großen Ozeanen, vier Kontinenten, riesigen Spaltenlandschaften und dem Ringsystem Scherbenkranz."
            },
            {
              "titel": "Seyvar III",
              "text": "7.800 km Durchmesser, Umlauf in 653,9 Tage. Seyvar III ist eine kalte, trockene Gesteinswelt mit dünner Atmosphäre am äußeren Rand der habitablen Zone."
            },
            {
              "titel": "Seyvar IV",
              "text": "128.000 km Durchmesser, Umlauf in 10,2 Jahre. Seyvar IV ist ein großer Gasriese mit hellen Wolkenbändern, dessen Schwerkraft das innere System gegen viele Kometen abschirmt."
            },
            {
              "titel": "Seyvar V",
              "text": "50.000 km Durchmesser, Umlauf in 43,1 Jahre. Seyvar V ist ein ferner, blassblauer Eisriese."
            },
            {
              "titel": "Prismenkomet",
              "text": "10 km Durchmesser, Umlauf in 64,2 Jahre. Ein Komet, dessen Staubschweif im Licht von Seyvar in Cyan- und Bernsteintönen schimmert. Er kehrt alle 58 Jahre wieder; frühe Darstellungen des Ringhimmels zeigen ihn neben dem Scherbenkranz."
            }
