          "titel": "Monde",
          "karten": [
            {
              "titel": "Aurenn I",
              "text": "9.200 km Durchmesser, Umlauf in 90,2 Tage. Aurenn I ist ein heißer, venusähnlicher Gesteinsplanet unter einer dichten, goldgelben Wolkendecke."
            },
            {
              "titel": "Namaris",
              "text": "12.360 km Durchmesser, Umlauf in 300,1 Tage. Namaris ist die wasserreiche Heimatwelt der Kohäriden mit Meeresbecken, Flussdeltas, flachen Binnenmeeren und Feuchtwäldern."
            },
            {
              "titel": "Aurenn III",
              "text": "8.200 km Durchmesser, Umlauf in 651,5 Tage. Aurenn III ist eine kalte, rostrote Wüstenwelt mit dünner Atmosphäre – erstes Ziel kohäridischer Außenposten."
            },
            {
              "titel": "Hohlkörper von Aurenn",
              "text": "56 km Durchmesser, Umlauf in 4,5 Jahre. Ein aufgebrochener Asteroid mit offenem, hohlem Inneren. Seine ungewöhnlich geringe Dichte gibt Forschern bis heute Rätsel auf."
            },
            {
              "titel": "Aurenn IV",
              "text": "140.000 km Durchmesser, Umlauf in 10,4 Jahre. Aurenn IV ist ein großer Gasriese mit 0,8 Jupitermassen und einem breiten, hellen Ringsystem."
            },
            {
              "titel": "Aurenn V",
              "text": "51.000 km Durchmesser, Umlauf in 39,5 Jahre. Aurenn V ist ein ferner, tiefblauer Eisriese."
            },
            {
              "titel": "Gezeitenbote",
              "text": "14 km Durchmesser, Umlauf in 43,8 Jahre. Ein periodischer Komet (rund 44 Jahre), der sich Aurenn bis auf 0,84 AE nähert – fast genau auf der Bahn von Namaris. Seine Wiederkehr wird seit den ersten Archiven aufgezeichnet."
            }
          ],
