    "Besonderheiten": {
      "gruppe": "Weitere",
      "icon": "✺",
      "intro": "Besonderheiten von Terev.",
      "abschnitte": [
        {
          "titel": "Besonderheiten",
          "liste": [
            "9 eigene Planeten: Vaskir, Sereth, Nerath, Talvek, Urakan, Oryss, Veyl, Relt, Othir"
          ]
        },
        {
          "titel": "Planeten",
          "karten": [
            {
              "titel": "Vaskir",
              "text": "9.430 km Durchmesser, Umlauf in 25,1 Tage. Vaskir ist eine heiße, trockene Gesteinswelt mit zahlreichen Einschlagkratern, alten Lavabecken und mineralischen Hochländern. Eine dichte Atmosphäre fehlt; die Temperaturen unterscheiden sich stark zwischen beleuchteten und unbeleuchteten Regionen."
            },
            {
              "titel": "Sereth",
              "text": "12.232 km Durchmesser, Umlauf in 106,8 Tage. Sereth ist ein heißer, vulkanisch aktiver Gesteinsplanet mit Lavabecken, Calderen und vulkanischen Hochländern. Seine dichte, nicht atembare Atmosphäre enthält Kohlendioxid und schwefelhaltige Gase."
            },
            {
              "titel": "Nerath",
              "text": "13.126 km Durchmesser, Umlauf in 352 Tage. Nerath ist die Heimatwelt der Synaptoiden (Tavari): eine gezeitengeprägte Binnenmeer-, Flachwasser- und Feuchtgebietswelt mit zwei großen Kontinenten, dem Silven-Becken, ausgedehnten Gezeitenmarschen und dem großen Mond Ivera."
            },
            {
              "titel": "Talvek",
              "text": "10.194 km Durchmesser, Umlauf in 2,1 Jahre. Talvek ist eine kalte, mineralreiche Gesteinswelt mit dunklen Gebirgen und gefrorenen Salzebenen. Zwei bis fünfzehn Kilometer tief in seiner Kruste leben die Lithonetzwerke – gigantische, im Gestein verwurzelte Intelligenzen."
            },
            {
              "titel": "Urakan",
              "text": "134.400 km Durchmesser, Umlauf in 9,9 Jahre. Urakan ist ein Gasriese mit 0,65 Jupitermassen, farbigen Wolkenbändern und dem langlebigen Großen Wirbel. Eine ausgedehnte Magnetosphäre, schmale Staub- und Gesteinsringe und vier größere Monde umgeben ihn."
            },
            {
              "titel": "Oryss",
              "text": "52.242 km Durchmesser, Umlauf in 30,5 Jahre. Oryss ist ein türkis bis blaugrau erscheinender Eisriese mit rund 20 Erdmassen, starken Winden und mehreren schmalen, diffusen Ringen. Seine Achsneigung von etwa 31° führt zu langen saisonalen Veränderungen."
            },
            {
              "titel": "Veyl",
              "text": "18.476 km Durchmesser, Umlauf in 117 Jahre. Veyl ist ein äußerer eisreicher Planet mit Wassereis, mineralischen Ablagerungen und gefrorenen flüchtigen Stoffen. Seine exzentrische, um 14° geneigte Bahn verändert den Abstand zu Terev deutlich; die sehr kalte Atmosphäre wechselt saisonal ihre Dichte."
            },
            {
              "titel": "Relt",
              "text": "1.280 km Durchmesser, Umlauf in 313,6 Jahre. Relt ist ein dunkler, eisreicher Zwergplanetkandidat im Taren-Saum mit stark verkraterter Oberfläche."
            },
            {
              "titel": "Othir",
              "text": "1.520 km Durchmesser, Umlauf in 403 Jahre. Othir ist ein größerer eisreicher Körper des Taren-Saums mit Hinweisen auf mehrere geologische Entwicklungsphasen."
            }
          ],
          "verweise": [
