      "abschnitte": [
        {
          "titel": "Besonderheiten",
          "liste": [
            "10 Monde: Ysmeroth I, Ysmeroth II, Karynth, Ysmeroth IV, Ysmeroth V, Vorlaufende Trojaner, Nachlaufende Trojaner, Ysmeroth VI, Schwellenläufer, Ysmeroth B"
          ]
        },
        {
          "titel": "Monde",
          "karten": [
            {
              "titel": "Ysmeroth I",
              "text": "8.200 km Durchmesser, Umlauf in 11,4 Tage. Ysmeroth I ist ein sternnaher, ungewöhnlich dichter Eisenplanet. Er rotiert gebunden; auf seiner Tagseite glühen Gesteinsebenen bei über 600 °C."
            },
            {
              "titel": "Ysmeroth II",
              "text": "12.100 km Durchmesser, Umlauf in 125,1 Tage. Ysmeroth II ist eine Treibhauswelt unter einer geschlossenen, bernsteinfarbenen Wolkendecke. Sie umläuft den Stern genau doppelt so schnell wie Karynth – das erste Glied einer 1 : 2 : 4-Bahnresonanz."
            },
            {
              "titel": "Karynth",
              "text": "12.490 km Durchmesser, Umlauf in 249,5 Tage. Karynth ist die Heimatwelt der Metamorphen: eine alte, wasserreiche Gesteinswelt mit drei Kontinenten, Gezeitenlandschaften, gewaltigen Höhlensystemen und einer außergewöhnlich vielfältigen Biosphäre."
            },
            {
              "titel": "Ysmeroth IV",
              "text": "7.900 km Durchmesser, Umlauf in 499 Tage. Ysmeroth IV ist eine kalte Ockerwelt mit dünner Kohlendioxidhülle und salzigen Laugenseen, die trotz Frost flüssig bleiben. Sie braucht genau doppelt so lange wie Karynth – das äußere Glied der 1 : 2 : 4-Resonanzkette."
            },
            {
              "titel": "Ysmeroth V",
              "text": "141.000 km Durchmesser, Umlauf in 5,5 Jahre. Ysmeroth V ist ein stürmischer Super-Jupiter auf deutlich elliptischer Bahn. Er hat das Gebiet zwischen 1,6 und 5 AE leergeräumt; statt eines Asteroidengürtels sammeln sich Trümmer nur in seinen Lagrange-Punkten."
            },
            {
              "titel": "Vorlaufende Trojaner",
              "text": "92 km Durchmesser, Umlauf in 5,5 Jahre. Ein Schwarm dunkler, kohlenstoffreicher Asteroiden im vorauseilenden Lagrange-Punkt L4 von Ysmeroth V – stabil gehalten von der Schwerkraft des Riesen und des Sterns."
            },
            {
              "titel": "Nachlaufende Trojaner",
              "text": "76 km Durchmesser, Umlauf in 5,5 Jahre. Der Schwarm im nachlaufenden Lagrange-Punkt L5 von Ysmeroth V. Seine Brocken gelten als nahezu unverändertes Material aus der Entstehungszeit des Systems."
            },
            {
              "titel": "Ysmeroth VI",
              "text": "47.000 km Durchmesser, Umlauf in 57,3 Jahre. Ysmeroth VI ist ein tiefblauer Eisriese auf einer um 11,5° geneigten Bahn – vermutlich eine Spur früher Begegnungen mit dem Begleitstern Ysmeroth B."
            },
            {
              "titel": "Schwellenläufer",
              "text": "18 km Durchmesser, Umlauf in 545,8 Jahre. Ein Langperioden-Komet, den Ysmeroth B aus dem Graumantel ins innere System gelenkt hat. Bei seiner letzten Sternannäherung vor rund 490 Jahren zerbrach er in mehrere Fragmente; die Metamorphen verbinden ihn mit dem Beginn der Ära der Verschlossenen Schwellen."
            },
            {
              "titel": "Ysmeroth B",
              "text": "320.000 km Durchmesser, Umlauf in 5.431,3 Jahre. Ysmeroth B ist ein Roter Zwerg mit 21 % der Sonnenmasse auf einer weiten, exzentrischen Bahn um Ysmeroth. Am Himmel Karynths erscheint er als heller, rötlicher Stern, der in einem Umlauf von rund 5.400 Jahren langsam zwischen den Sternbildern wandert."
            }
          ],
