{
  "name": "aporia-worldbuilding-board",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev --host 127.0.0.1\"",
    "build": "tinacms build --content=local -c \"astro build\"",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "verify:content": "node scripts/verify-content.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.4",
    "@tinacms/astro": "^0.8.0",
    "astro": "^6.4.4",
    "markdown-it": "^14.1.0",
    "tinacms": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tinacms/cli": "^4.0.3",
    "@types/markdown-it": "^14.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3"
  }
}
